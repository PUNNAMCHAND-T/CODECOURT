# ── App ──
APP_ENV=development
LOG_LEVEL=info

# ── Database ──
DATABASE_URL=postgresql+asyncpg://codecourt:codecourt@localhost:5432/codecourt
POSTGRES_USER=codecourt
POSTGRES_PASSWORD=codecourt
POSTGRES_DB=codecourt

# ── GitHub ──
GITHUB_WEBHOOK_SECRET=your-webhook-secret-here
GITHUB_TOKEN=your-github-token-here

# ── LLM (fill in whichever provider you use) ──
GEMINI_API_KEY=your-gemini-api-key-here
# GROQ_API_KEY=your-groq-api-key-here

# ── Frontend ──
VITE_API_URL=http://localhost:8000

# ── Auth & Rate Limiting (Phase 6) ──
JWT_SECRET_KEY=change-me-to-a-secure-random-secret-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_TRIGGER_PER_MINUTE=10

# ── Cost Caps & Budget Limits (Phase 6) ──
MAX_REVIEW_BUDGET_USD=0.50
TENANT_DAILY_BUDGET_USD=10.00
CIRCUIT_BREAKER_TOKEN_LIMIT=50000

# ── Observability & Tracing (Phase 6: Optional Langfuse) ──
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key
LANGFUSE_HOST=https://cloud.langfuse.com
